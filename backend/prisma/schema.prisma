generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DENTIST
  CALL_CENTER
  SALES
  BANKO
}

enum AppointmentType {
  CONSULTATION
  TREATMENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeadStatus {
  NEW
  CONTACTED
  CLINIC_VISIT
  TREATMENT_APPROVED
  APPOINTMENT_BOOKED
  SOLD
}

enum TreatmentPlanStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments Appointment[]
}

model Patient {
  id            String      @id @default(uuid())
  hastaNo       String      @unique
  name          String
  surname       String
  tc            String      @unique
  phone         String
  email         String?
  birthDate     DateTime?
  gender        String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointments   Appointment[]
  medicalRecord  MedicalRecord?
  treatmentPlans TreatmentPlan[]
  leads          Lead[]
}

model MedicalRecord {
  id           String   @id @default(uuid())
  patientId    String   @unique
  patient      Patient  @relation(fields: [patientId], references: [id])
  allergies    String?
  chronicDiseases String?
  medications  String?
  dentalChart  Json?
  notes        String?
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id             String            @id @default(uuid())
  randevuNo      String            @unique
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  type           AppointmentType
  status         AppointmentStatus @default(PENDING)
  appointmentDate DateTime
  createdAt      DateTime          @default(now())
  notes          String?

  @@index([patientId])
  @@index([status])
  @@index([type])
}

model Lead {
  id          String      @id @default(uuid())
  name        String
  phone       String
  email       String?
  source      String
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])
  status      LeadStatus  @default(NEW)
  patientId   String?
  patient     Patient?    @relation(fields: [patientId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime    @default(now())

  @@index([status])
  @@index([source])
  @@index([campaignId])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  channel     String
  budget      Decimal?
  startDate   DateTime?
  endDate     DateTime?
  leads       Lead[]
  createdAt   DateTime @default(now())
}

model TreatmentPlan {
  id            String             @id @default(uuid())
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  status        TreatmentPlanStatus @default(DRAFT)
  totalPrice    Decimal
  discount      Decimal            @default(0)
  paymentPlan   Json?
  items         TreatmentItem[]
  invoices      Invoice[]
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TreatmentItem {
  id          String   @id @default(uuid())
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  toothNo     String?
  treatment   String
  price       Decimal
  quantity    Int      @default(1)
  stepOrder   Int      @default(1)
}

model Invoice {
  id          String   @id @default(uuid())
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id])
  amount      Decimal
  paidAmount  Decimal  @default(0)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

model MessageLog {
  id          String   @id @default(uuid())
  patientId   String?
  channel     String
  direction   String
  content     String
  sentAt      DateTime @default(now())

  @@index([patientId])
  @@index([channel])
}
