generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DENTIST
  CALL_CENTER
  SALES
  BANKO
}

enum AppointmentType {
  MEETING
  EXAMINATION
  TREATMENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeadStatus {
  NEW
  CONTACTED
  CLINIC_VISIT
  TREATMENT_APPROVED
  APPOINTMENT_BOOKED
  SOLD
}

enum TreatmentPlanStatus {
  DRAFT
  APPROVED
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum VisitStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
    id        String    @id @default(uuid())
    name      String
    email     String    @unique
    password  String
    role      UserRole
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    appointments        Appointment[]   @relation("AppointmentStaff")
    createdAppointments Appointment[]   @relation("AppointmentCreator")
    workingHours        WorkingHours[]
    createdPlans        TreatmentPlan[] @relation("PlanCreator")
    doctorPlans         TreatmentPlan[] @relation("PlanDoctor")
    commissions         Commission[]    @relation("UserCommission")
}

model Patient {
  id            String      @id @default(uuid())
  hastaNo       String      @unique
  name          String
  surname       String
  tc            String      @unique
  phone         String
  email         String?
  birthDate     DateTime?
  gender        String?
  address       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointments   Appointment[]
  medicalRecord  MedicalRecord?
  treatmentPlans TreatmentPlan[]
  leads          Lead[]
  visits         PatientVisit[]
  doctorCommissions Commission[] @relation("DoctorCommissionPatient")
  salesCommissions  Commission[] @relation("SalesCommissionPatient")
}

model MedicalRecord {
  id           String   @id @default(uuid())
  patientId    String   @unique
  patient      Patient  @relation(fields: [patientId], references: [id])
  allergies    String?
  chronicDiseases String?
  medications  String?
  dentalChart  Json?
  notes        String?
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id             String            @id @default(uuid())
  randevuNo      String            @unique
  patientId      String?
  patient        Patient?          @relation(fields: [patientId], references: [id])
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id])
  userId         String?
  user           User?             @relation("AppointmentStaff", fields: [userId], references: [id])
  createdById    String?
  createdBy      User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  type           AppointmentType
  status         AppointmentStatus @default(PENDING)
  channel        String?
  campaignId     String?
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  appointmentDate DateTime
  createdAt      DateTime          @default(now())
  notes          String?
  visit          PatientVisit?
  slot           Slot?

  @@index([patientId])
  @@index([leadId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([createdById])
}

enum SlotStatus {
  FREE
  APPOINTMENT
  LEAVE
  LUNCH
}

model WorkingHours {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  start     String   // HH:mm format
  end       String   // HH:mm format
  lunchStart String? // HH:mm format
  lunchEnd   String? // HH:mm format
  slots     Slot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Slot {
  id         String      @id @default(uuid()) @db.Uuid
  workingHoursId String
  workingHours WorkingHours @relation(fields: [workingHoursId], references: [id], onDelete: Cascade)
  slotTime   String      // HH:mm format
  status     SlotStatus  @default(FREE)
  appointmentId String? @unique
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([workingHoursId, slotTime])
  @@index([workingHoursId, slotTime])
}

model Lead {
  id          String      @id @default(uuid())
  name        String
  phone       String
  email       String?
  source      String
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id])
  status      LeadStatus  @default(NEW)
  patientId   String?
  patient     Patient?    @relation(fields: [patientId], references: [id])
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime    @default(now())

  appointments Appointment[]
  visits       PatientVisit[]
  commissions  Commission[]

  @@index([status])
  @@index([source])
  @@index([campaignId])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  channel     String
  budget      Decimal?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())

  leads        Lead[]
  appointments Appointment[]
  visits       PatientVisit[]
  plans        TreatmentPlan[]
}

model ServiceCategory {
    id          String   @id @default(uuid()) @db.Uuid
    name        String   @unique
    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Service {
    id          String   @id @default(uuid()) @db.Uuid
    category    String   // implant, treatment, surgery, product, etc.
    name        String
    description String?
    price       Decimal
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    items        TreatmentItem[]

    @@unique([category, name])
    @@index([category])
}

model TreatmentPlan {
    id            String             @id @default(uuid())
    patientId     String
    patient       Patient            @relation(fields: [patientId], references: [id])
    createdById   String?
    createdBy     User?              @relation("PlanCreator", fields: [createdById], references: [id])
    doctorId      String?   @db.Uuid
    doctor        User?              @relation("PlanDoctor", fields: [doctorId], references: [id])
    status        TreatmentPlanStatus @default(DRAFT)
    totalPrice    Decimal
    discount      Decimal            @default(0)
    paymentPlan   Json?
    channel       String?
    campaignId    String?
    campaign      Campaign?          @relation(fields: [campaignId], references: [id])
    items         TreatmentItem[]
    invoices      Invoice[]
    approvedAt    DateTime?
    createdAt     DateTime          @default(now())
    updatedAt     DateTime          @updatedAt

    @@index([createdById])
    @@index([doctorId])
    @@index([channel])
}

model TreatmentItem {
    id          String   @id @default(uuid())
    planId      String
    plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
    toothNo     String?
    serviceId   String?   @db.Uuid
    service      Service?  @relation(fields: [serviceId], references: [id])
    treatment   String
    price       Decimal
    quantity    Int      @default(1)
    stepOrder   Int      @default(1)
}

model Invoice {
  id          String   @id @default(uuid())
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id])
  amount      Decimal
  paidAmount  Decimal  @default(0)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  bankoCommissions Commission[]
}

model PatientVisit {
  id            String      @id @default(uuid())
  protokolNo    String      @unique
  appointmentId String?     @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patientId     String?
  patient       Patient?    @relation(fields: [patientId], references: [id])
  leadId        String?
  lead          Lead?       @relation(fields: [leadId], references: [id])
  channel       String?
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id])
  status        VisitStatus @default(WAITING)
  visitDate     DateTime    @default(now())
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([patientId])
  @@index([leadId])
  @@index([channel])
  @@index([status])
  @@index([visitDate])
}

model MessageLog {
  id          String   @id @default(uuid())
  patientId   String?
  channel     String
  direction   String
  content     String
  sentAt      DateTime @default(now())

  @@index([patientId])
  @@index([channel])
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  expenses    Expense[]
}

model Expense {
  id              String        @id @default(uuid())
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  name            String
  amount          Decimal
  expenseDate     DateTime
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([expenseDate])
}

model CommissionRate {
    id           String   @id @default(uuid())
    role         UserRole
    type         String   // doctor, sales, callcenter, banko
    serviceCategory String? // implant, treatment, surgery, product, etc.
    rate         Decimal  // percentage
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@unique([role, type])
}

model Commission {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation("UserCommission", fields: [userId], references: [id])
  type               String   // doctor, sales, callcenter, banko
  periodStart        DateTime
  periodEnd          DateTime
  totalAmount        Decimal
  commissionRate     Decimal
  calculatedAmount   Decimal
  status             String   // pending, calculated, paid
  calculatedAt       DateTime?
  paidAt             DateTime?
  paymentReference   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  doctorPatientId    String?
  doctorPatient      Patient? @relation("DoctorCommissionPatient", fields: [doctorPatientId], references: [id])

  salesPatientId     String?
  salesPatient       Patient? @relation("SalesCommissionPatient", fields: [salesPatientId], references: [id])

  callcenterLeadId   String?
  callcenterLead     Lead?    @relation(fields: [callcenterLeadId], references: [id])

  bankoInvoiceId     String?
  bankoInvoice       Invoice? @relation(fields: [bankoInvoiceId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([periodStart, periodEnd])
}
